{
  "name": "navibb",
  "version": "0.0.1",
  "description": "A phpBB inspired board. Everyone is always connected.",
  "keywords": [
    "forum"
  ],
  "license": "MIT",
  "author": "sugarkrap",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && cp -r src/styles dist/ && cp -r src/public dist/ && cp -r src/views dist/",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "dev:db": "docker compose -f docker-compose.dev.yml up mongo -d",
    "dev:full": "docker compose -f docker-compose.dev.yml up mongo -d && sleep 2 && pnpm dev",
    "dev:local": "podman compose -f docker-compose.dev.yml up --build -d mongo && pnpm dev",
    "test": "node --test dist/**/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/middie": "^9.3.3",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^8.1.0",
    "@fastify/view": "^12.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.0",
    "ejs": "^3.1.10",
    "fastify": "^5.2.0",
    "mongoose": "^8.10.0",
    "nodemailer": "^9.0.5",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0"
  }
}
