<%- include('partials/profile-header.ejs', { user: locals.user }) %>
<div class="tabbedView">
  <%- include('partials/profile-tabs.ejs', { activeTab: 'password' }) %>
  <div class="tabbedView-content password">
    <% if (locals.error) { %>
      <div class="navi-box error">
        <img src="/static/icons/stock_stop.png"/>
        <p>
          <%= locals.error %>
        </p>
      </div>
    <% } %>

    <% if (locals.message) { %>
      <div class="navi-box success">
        <img src="/static/icons/stock_book_green.png"/>
        <p>
          <%= locals.message %>
        </p>
      </div>
    <% } %>

    <form action="/profile/password" method="POST">
      <fieldset>
        <legend>Change password</legend>
        <div class="navi-control obligatory">
          <label class="navi-label" for="currentPassword"
            >Current:</label
          >
          <input
            class="navi-input"
            type="password"
            name="currentPassword"
            id="currentPassword"
            placeholder="Current password"
          />
        </div>
        <div class="navi-control obligatory">
          <label class="navi-label" for="newPassword">New:</label>
          <input
            class="navi-input"
            type="password"
            name="newPassword"
            id="newPassword"
            placeholder="New password"
          />
        </div>
        <div class="navi-control obligatory">
          <label class="navi-label" for="confirmPassword">Confirm:</label>
          <input
            class="navi-input"
            type="password"
            name="confirmPassword"
            id="confirmPassword"
            placeholder="Confirm new password"
          />
        </div>
        <p class="navi-control-description"><!-- aw shoot that's true i've made these description things but i haven't used it in the profile page -->
          Password must be at least 8 characters long.
        </p>
        <button class="navi-button" type="submit">
          <img src="/static/icons/stock_save.png" /> Update password
        </button>
      </fieldset>
    </form>
  </div>
</div>
