<div class="loginForm">
  <!-- i really, really should create a common -->
  <% if (locals.error) { %>
    <div class="navi-box error">
      <img src="/static/icons/stock_stop.png"/>
      <p>
        <%= locals.error %>
      </p>
    </div>
  <% } %>

  <% if (locals.message) { %>
    <div class="navi-box success">
      <img src="/static/icons/stock_book_green.png"/>
      <p>
        <%= locals.message %>
      </p>
    </div>
  <% } %>

  <form action="/forgot-password" method="POST">
    <fieldset>
      <legend>Forgot password</legend>
      <div class="navi-control">
        <label class="navi-label" for="email">Email:</label>
        <input
          class="navi-input"
          type="email"
          name="email"
          id="email"
          placeholder="Mail"
        />
      </div>
    </fieldset>
    <button class="navi-button" type="submit">
      <img src="/static/icons/stock_mail-send.png" /> Send reset link
    </button>
  </form>
  <p>Remembered it? <a href="/login">Login here</a></p>
</div>
