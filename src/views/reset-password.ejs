<div class="loginForm">
  <% if (locals.error) { %>
    <div class="navi-box error">
      <img src="/static/icons/stock_stop.png"/>
      <p>
        <%= locals.error %>
      </p>
    </div>
  <% } %>

  <form action="/reset-password/<%= token %>" method="POST">
    <fieldset>
      <legend>Reset password</legend>
      <div class="navi-control">
        <label class="navi-label" for="password">New password:</label>
        <input
          class="navi-input"
          type="password"
          name="password"
          id="password"
          placeholder="New password"
        />
      </div>
      <p class="navi-control-description">
        Password must be at least 8 characters long.
      </p>
    </fieldset>
    <button class="navi-button" type="submit">
      <img src="/static/icons/stock_save.png" /> Update password
    </button>
  </form>
</div>
