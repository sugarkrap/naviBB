<h3 class="navi-title">Admin panel</h3>
<div class="tabbedView">
  <%- include('partials/admin-tabs.ejs', { activeTab: 'banlog' }) %>
  <div class="tabbedView-content admin">
    <% if (locals.error) { %>
      <div class="navi-box error">
        <img src="/static/icons/stock_stop.png"/>
        <p>
          <%= locals.error %>
        </p>
      </div>
    <% } %>

    <% if (locals.message) { %>
      <div class="navi-box success">
        <img src="/static/icons/stock_book_green.png"/>
        <p>
          <%= locals.message %>
        </p>
      </div>
    <% } %>

    <fieldset>
      <legend>Ban log</legend>
      <% if (entries.length === 0) { %>
        <p>No bans have been recorded yet.</p>
      <% } else { %>
        <table class="navi-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Banned by</th>
              <th>Reason</th>
              <th>Banned until</th>
              <th>Ban type</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach((entry) => { %>
              <tr>
                <td>
                  <% if (entry.user) { %>
                    <a href="/profile/<%= entry.user._id %>"><%= entry.user.username %></a>
                  <% } else { %>
                    <em>deleted user</em>
                  <% } %>
                </td>
                <td><%= entry.bannedBy ? entry.bannedBy.username : 'unknown' %></td>
                <td><%= entry.reason || '-' %></td>
                <td>
                  <% if (entry.bannedUntil && entry.bannedUntil.getFullYear() > 9000) { %>
                    Permanent
                  <% } else if (entry.bannedUntil) { %>
                    <%= entry.bannedUntil.toDateString() %>
                  <% } else { %>
                    Permanent
                  <% } %>
                </td>
                <td>
                  <% if (entry.ip) { %>
                    Account + IP <span class="banLogIP"><%= entry.ip %></span>
                  <% } else { %>
                    Account
                  <% } %>
                </td>
                <td>
                  <% if (entry.active) { %>
                    <span class="banLogStatus active">Active</span>
                  <% } else { %>
                    <span class="banLogStatus inactive">Lifted</span>
                  <% } %>
                </td>
                <td class="banLogActions">
                  <% if (entry.user) { %>
                    <a class="navi-button" href="/moderator/ban/<%= entry.user._id %>">
                      Edit
                    </a>
                    <% if (entry.active) { %>
                      <form action="/moderator/ban/<%= entry.user._id %>/unban" method="post">
                        <input type="hidden" name="redirectTo" value="admin-ban-log" />
                        <button class="navi-button" type="submit">Unban</button>
                      </form>
                    <% } %>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </fieldset>
  </div>
</div>
