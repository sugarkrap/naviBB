<%- include('partials/profile-header.ejs', { user: locals.user }) %>
<div class="tabbedView">
  <%- include('partials/profile-tabs.ejs', { activeTab: 'privacy' }) %>
  <div class="tabbedView-content">
    <fieldset>
      <legend>Your data</legend>
      <div class="navi-button-group">
        <a class="navi-button" href="/profile/data">
          <img src="/static/icons/stock_save.png" /> Download
