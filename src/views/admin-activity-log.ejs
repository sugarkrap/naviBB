<h3 class="navi-title">Admin panel</h3>
<div class="tabbedView">
  <%- include('partials/admin-tabs.ejs', { activeTab: 'activity-log' }) %>
  <div class="tabbedView-content admin">
    <fieldset>
      <legend>Activity log</legend>
      <% if (logs.length === 0) { %>
        <p>No activity has been recorded yet.</p>
      <% } else { %>
        <table class="navi-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Actor</th>
              <th>Action</th>
              <th>Target</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <% logs.forEach((log) => { %>
              <tr>
                <td><%= log.createdAt.toLocaleString() %></td>
                <td><%= log.actorUsername %> (<%= log.actorRole %>)</td>
                <td><%= log.action %></td>
                <td><%= log.targetLabel || '-' %></td>
                <td><%= log.details || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </fieldset>
    <%- include('partials/pagination.ejs', { basePath, page, totalPages }) %>
  </div>
</div>
