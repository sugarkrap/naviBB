<h3 class="navi-title">Admin panel</h3>
<div class="tabbedView">
  <%- include('partials/admin-tabs.ejs', { activeTab: 'welcome-message' }) %>
  <div class="tabbedView-content admin">
    <% if (locals.error) { %>
      <div class="navi-box error">
        <img src="/static/icons/stock_stop.png"/>
        <p>
          <%= locals.error %>
        </p>
      </div>
    <% } %>

    <% if (locals.message) { %>
      <div class="navi-box success">
        <img src="/static/icons/stock_book_green.png"/>
        <p>
          <%= locals.message %>
        </p>
      </div>
    <% } %>

    <form action="/admin/welcome-message" method="POST">
      <fieldset>
        <legend>Welcome message</legend>
        <p class="navi-control-description">
          Shown at the top of the home page only, above the forums, inside an info box.
        </p>
        <div class="navi-control">
          <label class="removeLogoLabel">
            <input type="checkbox" name="enabled" <%= welcomeMessage.enabled ? 'checked' : '' %> />
            Enabled
          </label>
        </div>
        <%- include('partials/rich-text-editor.ejs', {
          legend: 'Message',
          content: welcomeMessage.content,
          processor: welcomeMessage.processor,
        }) %>
      </fieldset>

      <div class="navi-button-group">
        <button class="navi-button" type="submit">
          <img src="/static/icons/stock_save.png" /> Validate
        </button>
      </div>
    </form>
  </div>
</div>
