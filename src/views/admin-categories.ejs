<h3 class="navi-title">Admin panel</h3>
<div class="tabbedView">
  <%- include('partials/admin-tabs.ejs', { activeTab: 'categories' }) %>
  <div class="tabbedView-content admin">
    <% if (locals.error) { %>
      <div class="navi-box error">
        <img src="/static/icons/stock_stop.png"/>
        <p>
          <%= locals.error %>
        </p>
      </div>
    <% } %>

    <% if (locals.message) { %>
      <div class="navi-box success">
        <img src="/static/icons/stock_book_green.png"/>
        <p>
          <%= locals.message %>
        </p>
      </div>
    <% } %>

    <form id="categoriesForm" action="/admin/categories" method="POST" enctype="multipart/form-data">
      <fieldset>
        <legend>Categories</legend>
        <table class="navi-table">
          <thead>
            <tr>
              <th>Logo</th>
              <th>Name</th>
              <th>Description</th>
              <th>Parent</th>
              <th>Group</th>
              <th>New logo</th>
            </tr>
          </thead>
          <tbody>
            <% categories.forEach((cat) => { %>
              <tr
                class="categoryRow <%= cat.depth > 0 ? 'categoryRow--child' : 'categoryRow--root' %>"
                style="--category-depth: <%= cat.depth %>"
              >
                <td>
                  <% if (cat.logo) { %>
                    <img
                      class="navi-category-logo"
                      src="/static/categories/<%= cat.logo %>"
                      alt="<%= cat.name %> logo"
                    />
                  <% } %>
                </td>
                <td class="categoryRow-name">
                  <input
                    class="navi-input"
                    type="text"
                    name="name[<%= cat._id %>]"
                    value="<%= cat.name %>"
                  />
                </td>
                <td>
                  <input
                    class="navi-input"
                    type="text"
                    name="description[<%= cat._id %>]"
                    value="<%= cat.description %>"
                  />
                </td>
                <td>
                  <select class="navi-input" name="parent[<%= cat._id %>]">
                    <option value="">(none)</option>
                    <% categories.forEach((opt) => { %>
                      <% if (opt._id.toString() !== cat._id.toString()) { %>
                        <option
                          value="<%= opt._id %>"
                          <%= cat.parent && cat.parent.toString() === opt._id.toString() ? 'selected' : '' %>
                        ><%= opt.name %></option>
                      <% } %>
                    <% }) %>
                  </select>
                </td>
                <td>
                  <% if (cat.depth === 0) { %>
                    <select class="navi-input" name="group[<%= cat._id %>]">
                      <option value="">(<%= UNGROUPED_BOX_NAME %>)</option>
                      <% groups.forEach((g) => { %>
                        <option
                          value="<%= g._id %>"
                          <%= cat.group && cat.group.toString() === g._id.toString() ? 'selected' : '' %>
                        ><%= g.name %></option>
                      <% }) %>
                    </select>
                  <% } %>
                </td>
                <td>
                  <input type="file" name="logo[<%= cat._id %>]" accept="image/*" />
                  <% if (cat.logo) { %>
                    <label class="removeLogoLabel">
                      <input type="checkbox" name="removeLogo[<%= cat._id %>]" />
                      Remove logo
                    </label>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </fieldset>

      <fieldset>
        <legend>New category</legend>
        <div class="navi-control">
          <label class="navi-label" for="newName">Name:</label>
          <input
            class="navi-input"
            type="text"
            name="newName"
            id="newName"
            placeholder="Name"
          />
        </div>
        <div class="navi-control">
          <label class="navi-label" for="newDescription">Description:</label>
          <input
            class="navi-input"
            type="text"
            name="newDescription"
            id="newDescription"
            placeholder="Description"
          />
        </div>
        <div class="navi-control">
          <label class="navi-label" for="newLogo">Logo:</label>
          <input type="file" name="newLogo" id="newLogo" accept="image/*" />
        </div>
        <div class="navi-control">
          <label class="navi-label" for="newParent">Parent:</label>
          <select class="navi-input" name="newParent" id="newParent">
            <option value="">(none)</option>
            <% categories.forEach((opt) => { %>
              <option value="<%= opt._id %>"><%= opt.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="navi-control">
          <label class="navi-label" for="newGroup">Group:</label>
          <select class="navi-input" name="newGroup" id="newGroup">
            <option value="">(<%= UNGROUPED_BOX_NAME %>)</option>
            <% groups.forEach((g) => { %>
              <option value="<%= g._id %>"><%= g.name %></option>
            <% }) %>
          </select>
        </div>
      </fieldset>

      <div class="navi-button-group">
        <button class="navi-button" type="submit">
          <img src="/static/icons/stock_save.png" /> Validate
        </button>
      </div>
    </form>

    <script>
    (function() {
      var form = document.getElementById('categoriesForm');
      if (!form) return;

      function defaultSelectValue(select) {
        for (var i = 0; i < select.options.length; i++) {
          if (select.options[i].defaultSelected) return select.options[i].value;
        }
        return '';
      }

      function appendIfChanged(fd, field) {
        if (field.type === 'file') {
          if (field.files && field.files[0]) fd.append(field.name, field.files[0]);
        } else if (field.type === 'checkbox') {
          if (field.checked && field.checked !== field.defaultChecked) {
            fd.append(field.name, 'on');
          }
        } else if (field.tagName === 'SELECT') {
          if (field.value !== defaultSelectValue(field)) fd.append(field.name, field.value);
        } else if (field.value !== field.defaultValue) {
          fd.append(field.name, field.value);
        }
      }

      form.addEventListener('submit', function(e) {
        e.preventDefault();

        var fd = new FormData();
        var rows = form.querySelectorAll('tbody tr.categoryRow');
        for (var r = 0; r < rows.length; r++) {
          var fields = rows[r].querySelectorAll('input, select');
          for (var f = 0; f < fields.length; f++) {
            appendIfChanged(fd, fields[f]);
          }
        }

        ['newName', 'newDescription', 'newParent', 'newGroup'].forEach(function(id) {
          var el = document.getElementById(id);
          if (el) fd.append(el.name, el.value);
        });
        var newLogo = document.getElementById('newLogo');
        if (newLogo && newLogo.files && newLogo.files[0]) {
          fd.append(newLogo.name, newLogo.files[0]);
        }

        var submitButton = form.querySelector('button[type="submit"]');
        if (submitButton) submitButton.disabled = true;

        fetch(form.action, { method: 'POST', body: fd })
          .then(function(res) { return res.text(); })
          .then(function(html) {
            document.open();
            document.write(html);
            document.close();
          })
          .catch(function(err) {
            if (submitButton) submitButton.disabled = false;
            window.alert('Failed to save categories: ' + err.message);
          });
      });
    })();
    </script>

    <form action="/admin/category-groups" method="POST">
      <fieldset>
        <legend>Category groups</legend>
        <table class="navi-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Order</th>
              <th>Delete</th>
            </tr>
          </thead>
          <tbody>
            <% groups.forEach((g) => { %>
              <tr>
                <td>
                  <input
                    class="navi-input"
                    type="text"
                    name="name[<%= g._id %>]"
                    value="<%= g.name %>"
                  />
                </td>
                <td>
                  <input
                    class="navi-input"
                    type="number"
                    name="order[<%= g._id %>]"
                    value="<%= g.order %>"
                  />
                </td>
                <td>
                  <label class="removeLogoLabel">
                    <input type="checkbox" name="delete[<%= g._id %>]" />
                    Delete
                  </label>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </fieldset>

      <fieldset>
        <legend>New category group</legend>
        <div class="navi-control">
          <label class="navi-label" for="newGroupName">Name:</label>
          <input
            class="navi-input"
            type="text"
            name="newGroupName"
            id="newGroupName"
            placeholder="Name"
          />
        </div>
      </fieldset>

      <div class="navi-button-group">
        <button class="navi-button" type="submit">
          <img src="/static/icons/stock_save.png" /> Validate
        </button>
      </div>
    </form>
  </div>
</div>
