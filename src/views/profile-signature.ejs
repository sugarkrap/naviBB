<%- include('partials/profile-header.ejs', { user: locals.user }) %>
<div class="tabbedView">
  <%- include('partials/profile-tabs.ejs', { activeTab: 'signature' }) %>
  <div class="tabbedView-content profile">
    <% if (locals.error) { %>
      <div class="navi-box error">
        <img src="/static/icons/stock_stop.png"/>
        <p>
          <%= locals.error %>
        </p>
      </div>
    <% } %>

    <% if (locals.message) { %>
      <div class="navi-box success">
        <img src="/static/icons/stock_book_green.png"/>
        <p>
          <%= locals.message %>
        </p>
      </div>
    <% } %>

    <form action="/profile/signature" method="POST">
      <%- include('partials/rich-text-editor.ejs', {
        legend: 'Signature',
        fieldName: 'signature',
        processorName: 'signatureProcessor',
        content: locals.user.signature,
        processor: locals.user.signatureProcessor,
      }) %>
      <div class="profileFormAction">
        <button class="navi-button" type="submit">
          <img src="/static/icons/stock_save.png" /> Save signature
        </button>
      </div>
    </form>
  </div>
</div>
